# Copy to .env and adjust. Everything here overrides config/settings.yaml.
# Nested keys use double underscores: TRADING_<SECTION>__<KEY>.

# Shared TimescaleDB (defaults usually work)
#TRADING_DB__HOST=localhost
#TRADING_DB__PORT=5432
#TRADING_DB__USER=trading
#TRADING_DB__PASSWORD=trading
#TRADING_DB__NAME=trading

# Interactive Brokers Gateway
#TRADING_IBKR__PORT=4002
#TRADING_IBKR__CLIENT_ID=1
#TRADING_IBKR__EXTENDED_HOURS=false

# Alpaca news API (free paper account; key + secret from the paper dashboard)
#APCA_API_KEY_ID=
#APCA_API_SECRET_KEY=
