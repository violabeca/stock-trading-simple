# Copy to .env (git-ignored) next to docker-compose.yml. Keep comments on their own lines:
# compose reads a comment after an empty value as the value.

# Only applied when the tsdb volume is first created.
POSTGRES_PASSWORD=change-me
# Host port, bound to loopback only. Use 5433 on a laptop already running a cluster on 5432.
DB_PORT=5432
# Comma-separated futures symbols; empty = BTC ETH XLM ADA SOL DOGE XRP AVAX DOT LTC (USDT pairs).
DEPTH_SYMBOLS=
